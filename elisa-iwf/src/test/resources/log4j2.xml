<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="out" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{1} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="et.elisa.iwf" level="debug"/>
    <Logger name="com.mobius" level="info"/>
    <Root level="info">
      <AppenderRef ref="out"/>
    </Root>
  </Loggers>
</Configuration>
