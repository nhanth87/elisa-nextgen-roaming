      "mandatory_ies": [
        "UserName",
        "VisitedPlmnId"
      ]
    },
    {
      "seq": 3,
      "from": "HSS",
      "to": "DRA",
      "message": "UpdateLocationAnswer",
      "mandatory_ies": [
        "ResultCode",
        "OriginHost",
        "OriginRealm"
      ]
    },
    {
      "seq": 4,
      "from": "DRA",
      "to": "MME",
      "message": "UpdateLocationAnswer",
      "mandatory_ies": [
        "ResultCode"
      ]
    }
  ]
}